{
  "name": "gigadoc-vision-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/assets.mjs && vite --host 0.0.0.0",
    "build": "node scripts/assets.mjs && tsc --noEmit && vite build",
    "build:server": "pnpm run build --base /eye-test/ --outDir dist-server",
    "build:library": "node scripts/build-library.mjs",
    "package:library": "pnpm build:library && pnpm --dir dist-library pack --pack-destination ../artifacts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
